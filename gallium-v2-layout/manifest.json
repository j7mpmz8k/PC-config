{
  "name": "Gallium v2 Keyboard Layouts",
  "version": "1.0",
  "manifest_version": 3,
  "description": "Gallium v2 layouts (All combinations of Angle Mod and Punctuation Mod).",
  "permissions": [
    "input"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "input_components": [
    {
      "name": "Gallium v2",
      "type": "ime",
      "id": "gallium_v2_base",
      "description": "Standard Gallium v2 without any mods",
      "language": "en-US",
      "layouts": [
        "us"
      ]
    },
    {
      "name": "Gallium v2 (Angle Mod)",
      "type": "ime",
      "id": "gallium_v2_rowstag",
      "description": "Gallium v2 with Angle Mod",
      "language": "en-US",
      "layouts": [
        "us"
      ]
    },
    {
      "name": "Gallium v2 (Punct Mod)",
      "type": "ime",
      "id": "gallium_v2_punct",
      "description": "Gallium v2 with Punctuation Mod",
      "language": "en-US",
      "layouts": [
        "us"
      ]
    },
    {
      "name": "Gallium v2 (Angle Mod, Punct Mod)",
      "type": "ime",
      "id": "gallium_v2_qwerty_punct_rowstag",
      "description": "Gallium v2 with Angle Mod and Punctuation Mod",
      "language": "en-US",
      "layouts": [
        "us"
      ]
    }
  ]
}