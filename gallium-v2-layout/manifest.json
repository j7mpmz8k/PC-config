{
  "name": "Gallium v2 Keyboard Layouts",
  "version": "1.0",
  "manifest_version": 3,
  "description": "Gallium v2 layouts (Row-Staggered for standard laptops with Angle Mod, Column-Staggered for Ergo boards).",
  "permissions": ["input"],
  "background": {
    "service_worker": "background.js"
  },
  "input_components": [
    {
      "name": "Gallium v2 (Standard / Rowstag)",
      "type": "ime",
      "id": "gallium_v2_rowstag",
      "description": "Gallium v2 for standard keyboards",
      "language": "en-US",
      "layouts": ["us"]
    },
    {
      "name": "Gallium v2 (Ergo / Colstag)",
      "type": "ime",
      "id": "gallium_v2_colstag",
      "description": "Gallium v2 for ergonomic keyboards",
      "language": "en-US",
      "layouts": ["us"]
    }
  ]
}